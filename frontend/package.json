{
  "name": "tdx-local-board",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:workbench": "vite --config vite.workbench.config.ts",
    "build": "vue-tsc --noEmit && vite build",
    "build:workbench": "vue-tsc --noEmit && vite build --config vite.workbench.config.ts",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.12.0",
    "@vueuse/core": "^12.8.2",
    "echarts": "^5.5.1",
    "naive-ui": "^2.41.0",
    "pinia": "^3.0.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@unocss/reset": "^66.1.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.2",
    "unocss": "^66.1.0",
    "vite": "^6.0.3",
    "vitest": "^3.0.8",
    "vue-tsc": "^2.2.8"
  }
}
